# Environment variables for Find-A-Venue
# Copy this file to .env.local for local development.
# For Vercel deployment, set these in Project Settings → Environment Variables.

# Supabase URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://tcmnowwutjfhgelldpit.supabase.co

# Supabase anon key (public) — used by browser and server clients
# This is the same value as the "Publishable Key" in newer Supabase docs
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_WE-LEjhf1fs1nGZUhci1jQ_oxqrlb0P

# Supabase service role key (secret) — used for admin operations
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=